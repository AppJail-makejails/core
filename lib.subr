
PUID="${PUID:-1000}"; export PUID
PGID="${PGID:-1000}"; export PGID
PUSER="noroot"
HOMEDIR=/noroot

set_homedir()
{
    if [ -z "$1" ]; then
        err "usage: set_homedir <directory>"
        exit 1
    fi

    HOMEDIR="$1"
}

create_user()
{
    local errlevel
    local username
    local homedir

    username=`_pw_usershow "${PUSER}" | cut -d: -f1` || exit $?

    if [ "${username}" = "nouser" ]; then
        pw groupadd -n "${PUSER}" -g "${PGID}" && \
        pw useradd -n "${PUSER}" -d "${HOMEDIR}" -u "${PUID}" -g "${PGID}"

        errlevel=$?

        if [ ${errlevel} -ne 0 ]; then
            return ${errlevel}
        fi

        mkdir -p "${HOMEDIR}" || return $?
    fi

    # Maybe the home directory location has been updated.
    homedir=`_pw_usershow "${PUSER}" | cut -d: -f9` || exit $?

    change_owner "${homedir:-${HOMEDIR}}"
}

change_owner()
{
    if [ -z "$1" ]; then
        err "usage: change_owner <file>"
        exit 1
    fi

    find -f "$1" \
        \( -fstype rdonly \) -o \
        \( ! \( -user "${PUID}" -group "${PGID}" \) \
            -exec echo chown "${PUID}:${PGID}" {} + \)
}

_pw_usershow()
{
    if [ -z "$1" ]; then
        err "usage: _pw_usershow <user>"
        exit 1
    fi

    pw usershow -Fn "$1"
}

warn()
{
    echo "##!> $* <!##"
}

err()
{
    echo "###> $* <###"
}

info()
{
    echo "======> $* <======"
}

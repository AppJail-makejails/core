
PUID="${PUID:-1000}"; export PUID
PGID="${PGID:-1000}"; export PGID

create_user()
{
    pw groupadd -n noroot -g "${PGID}" && \
    pw useradd -n noroot -d /noroot -u "${PUID}" -g "${PGID}" && \
    mkdir -p /noroot && \
    chown noroot:noroot /noroot
}

warn()
{
    echo "##!> $* <!##"
}

err()
{
    echo "###> $* <###"
}

info()
{
    echo "======> $* <======"
}
